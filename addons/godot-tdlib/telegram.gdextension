[configuration]

entry_symbol = "tdjson_library_init"
compatibility_minimum = 4.5
reloadable = true

[icons]
TdJson = "icons/telegram.png"

[libraries]

windows.release.x86_64 = "bin/godot_tdlib_win_x86_64/godot_tdlib.dll"
windows.debug.x86_64 = "bin/godot_tdlib_win_x86_64/godot_tdlib_debug.dll"
linux.release.x86_64 = "bin/godot_tdlib_linux_x86_64/libgodot_tdlib.so"
linux.debug.x86_64 = "bin/godot_tdlib_linux_x86_64/libgodot_tdlib_debug.so"
android.debug.arm64 = "bin/godot_tdlib_android_arm64/libgodot_tdlib_debug.so"
android.release.arm64 = "bin/godot_tdlib_android_arm64/libgodot_tdlib.so"
android.debug.x86_64 = "bin/godot_tdlib_android_x86_64/libgodot_tdlib_debug.so"
android.release.x86_64 = "bin/godot_tdlib_android_x86_64/libgodot_tdlib.so"
android.debug.x86_32 = "bin/godot_tdlib_android_x86_32/libgodot_tdlib_debug.so"
android.release.x86_32 = "bin/godot_tdlib_android_x86_32/libgodot_tdlib.so"
android.debug.arm32 = "bin/godot_tdlib_android_arm32/libgodot_tdlib_debug.so"
android.release.arm32 = "bin/godot_tdlib_android_arm32/libgodot_tdlib.so"


[dependencies]

windows.x86_64 = {
    "bin/godot_tdlib_win_x86_64/libcrypto-3-x64.dll": "",
    "bin/godot_tdlib_win_x86_64/libssl-3-x64.dll": "",
    "bin/godot_tdlib_win_x86_64/tdjson.dll": "",
    "bin/godot_tdlib_win_x86_64/zlib1.dll": ""
}
linux.x86_64 = {
    "bin/godot_tdlib_linux_x86_64/libtdjson.so.1.8.64": ""
}
android.arm64 = {
    "bin/godot_tdlib_android_arm64/libtdjson.so": ""
}
android.x86_64 = {
    "bin/godot_tdlib_android_x86_64/libtdjson.so": ""
}
android.arm32 = {
    "bin/godot_tdlib_android_arm32/libtdjson.so": ""
}
android.x86_32 = {
    "bin/godot_tdlib_android_x86_32/libtdjson.so": ""
}